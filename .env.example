# ---------------------------------------------------------------------------
# Copy to .env and edit. NEVER commit .env (it is in .gitignore).
# ---------------------------------------------------------------------------

# --- Exchange (any ccxt id: binance, bybit, okx, kucoin, ...)
EXCHANGE_ID=binance
MARKET_TYPE=spot            # spot | future | swap
USE_TESTNET=false           # true -> exchange sandbox/testnet (recommended before live)

# --- API keys: only needed for LIVE mode. Paper mode never uses them.
API_KEY=
API_SECRET=
API_PASSWORD=               # only for exchanges that need a passphrase (okx, kucoin...)

# --- Mode. Paper trading is the default. Going live needs BOTH lines below.
PAPER_TRADING=true
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISKS

# --- Market
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
OHLCV_LIMIT=500

# --- Engine
POLL_INTERVAL_SEC=30
DB_PATH=data/tradingbot.db
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Paper account simulation
PAPER_STARTING_BALANCE=10000
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5

# --- Network retry (exponential backoff + jitter)
MAX_RETRIES=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

# --- HTTP API for the mobile / desktop apps (python -m api)
# Generate a token with: python -m api --generate-token
API_TOKEN=
API_HOST=127.0.0.1          # 0.0.0.0 exposes it to your network; prefer a VPN such as Tailscale
API_PORT=8000
API_CORS_ORIGINS=           # comma separated, only needed for browser-based clients
