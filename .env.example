# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file.

# --- Mode ---------------------------------------------------------------
# True = simulated fills only, no real orders are ever sent (default).
# Switching to False is a deliberate, separate step - see README.md.
PAPER_TRADING=True

# --- Exchange (ccxt) ------------------------------------------------------
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Only needed by some exchanges (e.g. OKX, KuCoin):
EXCHANGE_API_PASSWORD=
# Use the exchange's sandbox/testnet endpoints where supported.
EXCHANGE_SANDBOX=True

# --- Trading ---------------------------------------------------------------
SYMBOL=BTC/USDT
TIMEFRAME=15m
CANDLE_LOOKBACK=300
POLL_INTERVAL_SECONDS=5

# --- Account / paper trading -----------------------------------------------
QUOTE_CURRENCY=USDT
PAPER_STARTING_BALANCE=10000

# --- Retry / backoff ---------------------------------------------------------
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
RETRY_JITTER=0.5

# --- Strategy defaults (seeded into state_manager on first run only;
#     after that, edit them live from the dashboard) ------------------------
EMA_TREND_PERIOD=200
RSI_PERIOD=14
RSI_LOWER=40
RSI_UPPER=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
VOLUME_MA_PERIOD=20
VOLUME_CONFIRMATION_MULTIPLIER=1.2
DONCHIAN_PERIOD=20
ATR_PERIOD=14

# --- Risk management ---------------------------------------------------------
RISK_PER_TRADE_PCT=1.0
RISK_REWARD_RATIO=2.0
ATR_SL_MULTIPLIER=1.5
TRAILING_ATR_MULTIPLIER=1.5
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_CONCURRENT_POSITIONS=3
MAX_EXPOSURE_PER_SYMBOL_PCT=20.0

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
